{
  "name": "obsidian-collab-web",
  "version": "0.8.3",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "serve": "npm run build && cd ../server && cargo run --bin server",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=text-summary --coverage.reporter=html --coverage.reportsDirectory=coverage --coverage.include='src/**' --coverage.include='lib/src/**' --coverage.exclude='**/*.test.ts' --coverage.exclude='**/test-support/**'",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "biome check . && svelte-check --tsconfig ./tsconfig.json",
    "lint:fix": "biome check --write .",
    "replay": "node replay-traces.mjs",
    "bench": "node bench.mjs",
    "build:lib": "node lib/build.mjs",
    "check:ui": "node scripts/ui/check.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/literata": "^5.3.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "codemirror": "^6.0.2",
    "katex": "^0.18.9",
    "loro-crdt": "^1.16.4",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-texmath": "^1.0.0",
    "pele": "1.6.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@hegeldev/hegel": "^0.4.6",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "jsqr": "1.4.0",
    "loro-crdt-1163": "npm:loro-crdt@1.16.3",
    "obsidian": "1.14.4",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5",
    "ws": "^8.21.3"
  }
}
